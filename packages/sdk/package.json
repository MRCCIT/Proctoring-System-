{
  "name": "@proctorshield/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./core": "./src/core/index.ts",
    "./exam-window": "./src/exam-window/index.ts",
    "./admin-panel": "./src/admin-panel/index.ts",
    "./lockdown": "./src/lockdown/index.ts",
    "./media": "./src/media/index.ts",
    "./ai-client": "./src/ai-client/index.ts",
    "./events": "./src/events/index.ts"
  },
  "files": ["src", "dist", "README.md"],
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.mjs",
        "require": "./dist/core/index.js"
      },
      "./exam-window": {
        "types": "./dist/exam-window/index.d.ts",
        "import": "./dist/exam-window/index.mjs",
        "require": "./dist/exam-window/index.js"
      },
      "./admin-panel": {
        "types": "./dist/admin-panel/index.d.ts",
        "import": "./dist/admin-panel/index.mjs",
        "require": "./dist/admin-panel/index.js"
      },
      "./lockdown": {
        "types": "./dist/lockdown/index.d.ts",
        "import": "./dist/lockdown/index.mjs",
        "require": "./dist/lockdown/index.js"
      },
      "./media": {
        "types": "./dist/media/index.d.ts",
        "import": "./dist/media/index.mjs",
        "require": "./dist/media/index.js"
      },
      "./ai-client": {
        "types": "./dist/ai-client/index.d.ts",
        "import": "./dist/ai-client/index.mjs",
        "require": "./dist/ai-client/index.js"
      },
      "./events": {
        "types": "./dist/events/index.d.ts",
        "import": "./dist/events/index.mjs",
        "require": "./dist/events/index.js"
      }
    }
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": { "optional": true }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "echo ok"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.5.0"
  }
}
