# Platform API (services/platform-api)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/proctorshield
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000
AI_SERVICE_URL=http://127.0.0.1:5055

# Demo tenant SDK key (synced by db:seed into apps/candidate-exam-app/.env)
SEED_DEMO_API_KEY=psk_live_dev-demo-university-local-only
# Reference face for identity checks — place savej-reference.png in /assets
SEED_SAVEJ_IMAGE=assets/savej-reference.png

# Frontends (copy to apps/*/.env.local as needed)
NEXT_PUBLIC_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
VITE_API_KEY=psk_live_dev-demo-university-local-only
