# Platform API (services/platform-api)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/proctorshield
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000
TENANT_ADMIN_PORTAL_URL=http://localhost:3200
AI_SERVICE_URL=http://127.0.0.1:5055

# Demo tenant SDK key (synced by db:seed into apps/candidate-exam-app/.env)
SEED_DEMO_API_KEY=psk_live_dev-demo-university-local-only-key
# Reference face for identity checks — place savej-reference.png in /assets
SEED_SAVEJ_IMAGE=assets/savej-reference.png

# Recording merge + compression (requires ffmpeg on PATH or FFMPEG_PATH)
# RECORDING_COMPRESS=1
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# RECORDING_CRF=28
# RECORDING_PRESET=veryfast
# RECORDING_MAX_HEIGHT=720
# RECORDING_AUDIO_KBIT=64
# STORAGE_DIR=./storage

# Frontends (copy to apps/*/.env.local as needed)
NEXT_PUBLIC_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
VITE_API_KEY=psk_live_dev-demo-university-local-only-key
