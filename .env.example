# Platform API (services/platform-api)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/proctorshield
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3000
PUBLIC_API_BASE_URL=http://localhost:3000
TENANT_ADMIN_PORTAL_URL=http://localhost:3200
AI_SERVICE_URL=http://127.0.0.1:5055

# Demo tenant SDK key (synced by db:seed into apps/candidate-exam-app/.env)
SEED_DEMO_API_KEY=psk_live_dev-demo-university-local-only-key
# Reference face for identity checks — place savej-reference.png in /assets
SEED_SAVEJ_IMAGE=assets/savej-reference.png

# Recording merge + dual compression (requires ffmpeg on PATH or FFMPEG_PATH)
# RECORDING_COMPRESS=1
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# STORAGE_DIR=./storage
#
# Dual storage: keep original WebM + async AV1/VP9/H.264 compressed derivative
# VIDEO_COMPRESSION_ENABLED=true
# VIDEO_COMPRESSION_CODEC=av1
# VIDEO_COMPRESSION_ENCODER=libsvtav1
# VIDEO_COMPRESSION_PROFILE=BALANCED
# VIDEO_COMPRESSION_CRF=36
# VIDEO_COMPRESSION_PRESET=6
# VIDEO_COMPRESSION_WIDTH=854
# VIDEO_COMPRESSION_HEIGHT=480
# VIDEO_COMPRESSION_FPS=15
# VIDEO_COMPRESSION_AUDIO_CODEC=libopus
# VIDEO_COMPRESSION_AUDIO_BITRATE=48k
# VIDEO_COMPRESSION_KEEP_ORIGINAL=true
# VIDEO_COMPRESSION_GENERATE_H264_FALLBACK=false
# VIDEO_COMPRESSION_MAX_WORKERS=1
# VIDEO_COMPRESSION_MAX_RETRIES=3
# VIDEO_COMPRESSION_TIMEOUT_SECONDS=7200
# Legacy H.264 knobs (used when AV1/VP9 encoders unavailable)
# RECORDING_CRF=26
# RECORDING_PRESET=medium
# RECORDING_AUDIO_KBIT=64
# Optional Redis for BullMQ media jobs (falls back to in-process without Redis)
# REDIS_URL=redis://127.0.0.1:6379

# Frontends (copy to apps/*/.env.local as needed)
NEXT_PUBLIC_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
VITE_API_KEY=psk_live_dev-demo-university-local-only-key
